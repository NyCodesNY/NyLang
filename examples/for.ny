function void Main() {
    System.Print("Counting from 0 to 4 using a for loop:");
    for (int i = 0; i < 5; i = i + 1) {
        System.Print(i);
    }
    
    System.Print("Counting down from 5 to 1:");
    for (init j = 5; j > 0; j = j - 1) {
        System.Print(j);
    }

    System.Print("Done!");
}
