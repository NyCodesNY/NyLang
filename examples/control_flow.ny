function Main() {
    System.Print("Testing if statement...");
    if (1 < 2) {
        System.Print("SUCCESS: 1 is less than 2");
    } else {
        System.Print("FAIL: 1 is not less than 2");
    }

    System.Print("Testing while loop...");
    if (5 == 5) {
        System.Print("SUCCESS: 5 equals 5");
    }
}
